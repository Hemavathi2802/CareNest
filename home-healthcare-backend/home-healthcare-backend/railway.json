{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "chmod +x mvnw && ./mvnw -DskipTests package"
  },
  "deploy": {
    "startCommand": "java -jar target/home-healthcare-backend-0.0.1-SNAPSHOT.jar",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
